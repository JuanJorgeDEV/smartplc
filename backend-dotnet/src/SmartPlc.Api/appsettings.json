{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Process": {
    "NivelBaixo": 10.0,
    "NivelAlto": 90.0,
    "LeituraMin": 0.0,
    "LeituraMax": 100.0
  },
  "Telemetry": {
    "StaleAfterSeconds": 5
  },
  "Ingest": {
    "ApiKey": ""
  },
  "Control": {
    "Enabled": false,
    "OperatorApiKey": ""
  },
  "NodeRed": {
    "ComandoUrl": "http://127.0.0.1:1880/api/comando-clp",
    "TimeoutSeconds": 2
  },
  "ConnectionStrings": {
    "SmartPlc": ""
  },
  "History": {
    "Enabled": true,
    "SampleIntervalSeconds": 10,
    "MinimumLevelChange": 0.5,
    "MinimumValveChange": 2.0,
    "RecordEvents": true,
    "MigrateOnStartup": false,
    "Retention": {
      "Enabled": false,
      "SamplesDays": 14,
      "EventsDays": 365
    }
  },
  "Command": {
    "ConfirmationSeconds": 10
  },
  "Lab": {
    "Enabled": true,
    "WriteEnabled": true
  },
  "Integration": {
    "ShowAddresses": true
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
