    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5f328ac3-22fa-4ca2-93d4-40305b2d66b8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
