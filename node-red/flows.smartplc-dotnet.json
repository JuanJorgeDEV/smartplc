    {
        "id": "smartplc0000comandos",
        "type": "function",
        "z": "47cce3c81373f633",
        "name": "SMARTPLC-COMANDOS",
        "func": "// Comandos que o SmartPLC na nuvem deixou na fila chegam na RESPOSTA da telemetria que este fluxo enviou\n// (a conexão parte sempre daqui: o servidor não alcança esta máquina). Cada comando vai ao mesmo tratador do /api/comando-clp.\nconst r = msg.payload;\nif (msg.statusCode !== 200 || !r || typeof r !== 'object' || !Array.isArray(r.comandos) || r.comandos.length === 0) { return null; }\n\n// Defesa extra: só os campos conhecidos, com tipo e faixa válidos. O que não passar não vai ao CLP.\nconst faixa = { setpoint: [0, 100], valvulaManual: [0, 100], kp: [0, 1000], ti: [0, 100000], td: [0, 100000] };\nconst saidas = [];\nfor (const c of r.comandos) {\n    const campos = {};\n    const origem = (c && typeof c.campos === 'object' && c.campos) ? c.campos : {};\n    for (const k of Object.keys(faixa)) {\n        if (origem[k] === undefined || origem[k] === null) { continue; }\n        const v = Number(origem[k]);\n        if (Number.isFinite(v) && v >= faixa[k][0] && v <= faixa[k][1]) { campos[k] = v; }\n        else { node.warn('comando ' + (c && c.id) + ': ' + k + ' fora da faixa, ignorado'); }\n    }\n    if (typeof origem.modoManual === 'boolean') { campos.modoManual = origem.modoManual; }\n    if (Object.keys(campos).length > 0) { saidas.push({ payload: campos, comandoId: c.id }); }\n}\nif (saidas.length > 0) { node.warn(saidas.length + ' comando(s) recebido(s) do SmartPLC'); }\nreturn [saidas];",
