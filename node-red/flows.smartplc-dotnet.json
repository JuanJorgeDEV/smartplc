        "format": "<template>\n    <!-- Container Principal das Badges (Amarelo -> Verde -> Vermelho) -->\n    <div class=\"alarm-badges-container\">\n        \n        <!-- 1. Amarelo (Baixo < 10%) -->\n        <div class=\"badge-item\">\n            <div class=\"dot yellow\" :class=\"{ 'active': msg?.payload?.low }\"></div>\n            <span class=\"label\">L</span>\n        </div>\n\n        <!-- 2. Verde (Normal 10% - 90%) -->\n        <div class=\"badge-item\">\n            <div class=\"dot green\" :class=\"{ 'active': msg?.payload?.normal }\"></div>\n            <span class=\"label\">N</span>\n        </div>\n\n        <!-- 3. Vermelho (Alto > 90%) -->\n        <div class=\"badge-item\">\n            <div class=\"dot red\" :class=\"{ 'active': msg?.payload?.high }\"></div>\n            <span class=\"label\">H</span>\n        </div>\n\n    </div>\n</template>\n\n<style>\n    .alarm-badges-container {\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        gap: 24px;\n        padding: 6px;\n        background-color: transparent;\n    }\n\n    .badge-item {\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        gap: 4px;\n    }\n\n    .dot {\n        width: 20px;\n        height: 20px;\n        border-radius: 50%;\n        transition: all 0.3s ease;\n        border: 1px solid rgba(255,255,255,0.15);\n    }\n\n    .label {\n        font-size: 11px;\n        font-weight: bold;\n        color: hsla(0, 0%, 0%, 0.80);\n        opacity: 0.6;\n    }\n\n    /* Cores Apagadas (Opacidade Baixa / Escuras) */\n    .dot.yellow { background-color: #42380e; }\n    .dot.green  { background-color: #0d381e; }\n    .dot.red    { background-color: #451313; }\n\n    /* Cores Acesas (Brilhantes + Efeito Glow) */\n    .dot.yellow.active {\n        background-color: #d29922 !important;\n        box-shadow: 0 0 12px #d29922 !important;\n    }\n\n    .dot.green.active {\n        background-color: #2ea44f !important;\n        box-shadow: 0 0 12px #2ea44f !important;\n    }\n\n    .dot.red.active {\n        background-color: #f85149 !important;\n        box-shadow: 0 0 12px #f85149 !important;\n    }\n</style>",
