        "id": "8eedbf3e4c25f3ca",
        "type": "function",
        "z": "47cce3c81373f633",
        "name": "function 1",
        "func": "let nivel = Number(msg.payload);\n\nmsg.payload = {\n    low: nivel < 10.0,\n    normal: nivel >= 10.0 && nivel <= 90.0,\n    high: nivel > 90.0\n};\n\nreturn msg;",
